# Copy to .env and edit. `npm start` loads it automatically.

# Your existing Postgres. Tables go in their own schema, nothing else is touched.
DATABASE_URL=postgres://monitor:change-me@127.0.0.1:5432/postgres
DB_SCHEMA=nodemon
# DATABASE_SSL=1
# Uses TimescaleDB automatically when the extension is available. Set off to force a plain table.
# TIMESCALE=off

HOST=0.0.0.0
PORT=8787
# Address the agents use to reach this hub (Tailscale MagicDNS name or 100.x IP).
# Used to build the install commands shown in the UI.
PUBLIC_URL=http://my-hub:8787

# Access tokens never expire. Browser sessions do: re-enter the token every SESSION_DAYS.
SESSION_DAYS=7
# Set to 1 when serving over HTTPS (e.g. `tailscale serve`).
# COOKIE_SECURE=1

RETENTION_DAYS=30
OFFLINE_AFTER_SEC=20

# Optional: POST {"content","text"} on alert open/resolve (Discord, Slack, ntfy, n8n...).
# ALERT_WEBHOOK_URL=
