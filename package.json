{
  "name": "node-monitor",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lightweight multi-node server monitor: cron push agents over LAN/Tailscale, Postgres/Timescale history, live web UI.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "token": "node --env-file-if-exists=.env scripts/token.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
